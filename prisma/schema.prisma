// prisma/schema.prisma — la fuente de verdad del modelo de datos
// (es el diagrama de clases de la semana 2, en otra sintaxis)

generator client {
  provider = "prisma-client"            // cliente moderno de Prisma 7
  output   = "../src/generated/prisma"  // dónde se genera (no se sube a git)
}

datasource db {
  provider = "postgresql"               // la URL vive en prisma7.config.ts → .env
}

model Socio {
  email      String  @unique
  id         Int     @id @default(autoincrement())
  nombre     String
  creadoEn   DateTime @default(now())
  prestamos Prestamo[]
}

model Libro {
  id         Int     @id @default(autoincrement())
  titulo     String
  autor      String
  isbn       String     @unique
  ejemplaresTotales       Int
  ejemplaresDisponibles       Int
  prestamos Prestamo[]
}

enum EstadoPrestamo {
  ACTIVO
  DEVUELTO
}

model Prestamo {
  id        Int          @id @default(autoincrement())
  socioId   Int         
  libroId   Int         
  estado    EstadoPrestamo  @default(ACTIVO)
  fechaPrestamo   DateTime        @default(now())
  fechaLimite     DateTime
  fechaDevolucion DateTime?
  socio Socio @relation(fields: [socioId], references: [id])
  libro Libro @relation(fields: [libroId], references: [id])
}